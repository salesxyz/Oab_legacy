# === Ambiente ===
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333
WEB_URL=http://localhost:5173

# === Banco de dados ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oab_mentoria?schema=public

# === Autenticação ===
JWT_SECRET=troque_este_valor_por_um_segredo_forte
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=troque_este_valor_por_outro_segredo_forte
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# === Recuperação de senha ===
PASSWORD_RESET_CODE_EXPIRES_IN_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# === Rate limiting ===
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# === Email (produção) ===
# Provider suportado: "console" (dev, apenas loga) | "resend" | "sendgrid" | "smtp"
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="OAB Mentoria <no-reply@oabmentoria.com.br>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# === Stripe ===
# Deixe vazio apenas para desenvolver sem checkout; pagamentos reais exigem os dois segredos.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
STRIPE_BASIC_PRICE_CENTS=9700
STRIPE_LIFETIME_PRICE_CENTS=299799

# === Seed / usuários de teste (SOMENTE development) ===
SEED_TEST_USER_EMAIL=teste@exemplo.com
SEED_TEST_USER_PASSWORD=SenhaTeste123!
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=AdminTeste123!
SEED_MENTOR_EMAIL=professor@exemplo.com
SEED_MENTOR_PASSWORD=ProfessorTeste123!
