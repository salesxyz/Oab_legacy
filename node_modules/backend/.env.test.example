# Copie para .env.test e ajuste. Usado exclusivamente pela suíte de testes
# automatizados (npm test). Aponta para um banco de dados SEPARADO do de
# desenvolvimento, para que os testes possam truncar tabelas livremente.

NODE_ENV=test
PORT=3334
APP_URL=http://localhost:3334
WEB_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oab_mentoria_test?schema=public

JWT_SECRET=test_jwt_secret_troque_por_qualquer_valor_com_16_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=test_refresh_secret_troque_por_qualquer_valor_com_16_chars
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

PASSWORD_RESET_CODE_EXPIRES_IN_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="OAB Mentoria <no-reply@oabmentoria.com.br>"

CORS_ALLOWED_ORIGINS=http://localhost:5173

SEED_TEST_USER_EMAIL=teste@exemplo.com
SEED_TEST_USER_PASSWORD=SenhaTeste123!
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=AdminTeste123!
